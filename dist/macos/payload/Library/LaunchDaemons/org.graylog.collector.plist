<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>org.graylog.collector</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Library/Application Support/Graylog/Graylog Collector.app/Contents/MacOS/graylog-collector</string>
      <string>supervisor</string>
    </array>

    <key>AssociatedBundleIdentifiers</key>
    <array>
      <string>org.graylog.collector</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- The Collector default graceful shutdown timeout is 30 seconds -->
    <key>ExitTimeOut</key>
    <integer>60</integer>

    <!-- Logs live under /Library/Logs, NOT /var/log: macOS OS upgrades
         delete /var/log contents. -->
    <key>StandardOutPath</key>
    <string>/Library/Logs/Graylog/Collector/graylog-collector.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/Graylog/Collector/graylog-collector.log</string>
  </dict>
</plist>
